# ============================================================================
# Coletor de micro-influencers Zafe — configuração
# Copie para `.env` e preencha. NENHUMA variável aqui é de serviço pago.
# ============================================================================

# Caminho para o JSON da service account do Google (GRATUITA).
# Veja o README: "Como criar a service account".
GOOGLE_SHEETS_CREDENTIALS=./service-account.json

# ID da planilha de destino (já criada). Não precisa alterar.
SHEET_ID=1BW8CjumkH6cOw3lRCYLmHiBWEKn_1ZejV1j9rm3WiyA

# Filtros de coleta
FOLLOWER_MIN=500
FOLLOWER_MAX=10000
REGION=BR

# Máximo de novos leads gravados por execução (protege rate limits e a planilha).
LIMIT=50

# URL base do concurso para o link de referência por handle.
# Resultado final: https://zafe.app.br/concurso/entrar?ref=<handle>
CONCURSO_REF_BASE=https://zafe.app.br/concurso/entrar

# ----------------------------------------------------------------------------
# Automação OPCIONAL da busca gratuita da Modash (--source modash).
# Deixe em branco/padrão para usar o modo CSV (recomendado e sem risco de ToS).
# ----------------------------------------------------------------------------
MODASH_FREE_URL=https://www.modash.io/free-influencer-search-tool
# User-agent usado para checar robots.txt e navegar de forma educada.
SCRAPER_USER_AGENT=ZafeCreatorOutreach/1.0 (+https://zafe.app.br; contato via site)
# Segundos de espera entre ações no navegador (respeito a rate limit).
SCRAPER_DELAY_SECONDS=4
