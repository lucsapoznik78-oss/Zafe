# ============================================================================
# Loop de abordagem Zafe — configuração. Copie para `.env` e preencha.
# NENHUMA variável aqui é de serviço pago (orçamento do projeto: R$ 0,00).
# ============================================================================

# JSON da service account gratuita do Google (a MESMA dos coletores).
GOOGLE_SHEETS_CREDENTIALS=./service-account.json

# Planilha viva (Página1 = influencers, Página2 = grupos). Não precisa alterar.
SHEET_ID=1BW8CjumkH6cOw3lRCYLmHiBWEKn_1ZejV1j9rm3WiyA

# Faixas de qualificação
SEGUIDORES_MIN=500
SEGUIDORES_MAX=100000
MEMBROS_MIN=50
MEMBROS_MAX=100000

# Link base do concurso para o link de referência (só usado no fechamento).
CONCURSO_REF_BASE=https://zafe.app.br/concurso/entrar

# Tetos conservadores por passada (protege a planilha e evita spam).
IG_LOTE_MAX=40
WA_LOTE_MAX=15

# Pasta onde a fila de envio humano (outbox) e os relatórios são escritos.
OUTBOX_DIR=./outbox
